{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_secrets.py\"",
            "timeout": 10,
            "statusMessage": "Checking for secret keys..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_legal.py\"",
            "timeout": 10,
            "statusMessage": "Checking the legal lines..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/backup_page.py\"",
            "timeout": 10,
            "statusMessage": "Backing up the page..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_html.py\"",
            "timeout": 15,
            "statusMessage": "Checking the HTML..."
          }
        ]
      }
    ]
  }
}
